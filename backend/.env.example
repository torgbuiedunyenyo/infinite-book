# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/infinite_book

# Anthropic API key for Claude
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Server port (default: 3000)
PORT=3000

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=debug

# Node environment: development, production
NODE_ENV=development

# ==================== LANGFUSE (LLM Observability & Evaluation) ====================
# Sign up at https://langfuse.com and create a project to get these keys
# Enables tracing of all LLM calls and quality evaluations

# Langfuse API keys (required for tracing/evaluation)
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key

# Langfuse host (defaults to US cloud if not specified)
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
